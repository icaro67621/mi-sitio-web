{
  "platform": {
    "apiRuntime": "node:20"
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube-nocookie.com https://open.spotify.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests",
    "Strict-Transport-Security": "max-age=31536000",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "Cross-Origin-Opener-Policy": "same-origin"
  },
  "routes": [
    {
      "route": "/.github/*",
      "statusCode": 404
    },
    {
      "route": "/tools/*",
      "statusCode": 404
    },
    {
      "route": "/ciberseguridad/lab/INSTRUCTOR.md",
      "statusCode": 404
    },
    {
      "route": "/ciberseguridad/lab/reset-lab.sh",
      "statusCode": 404
    },
    {
      "route": "/ciberseguridad/lab/check-lab.sh",
      "statusCode": 404
    },
    {
      "route": "/ciberseguridad/lab/package.json",
      "statusCode": 404
    },
    {
      "route": "/labs/*",
      "statusCode": 404
    },
    {
      "route": "/CLAUDE.md",
      "statusCode": 404
    },
    {
      "route": "/ciberseguridad/*",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    }
  ]
}
